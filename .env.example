# PostgreSQL used by FastAPI
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/recovery

# Razorpay Test Mode API credentials
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Secret configured separately in the Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=replace_with_a_different_secret

# Groq structured extraction
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-20b

# Promise deadline calculations
BUSINESS_TIMEZONE=Asia/Kolkata

# Used only by scripts/seed_demo_invoice.py
DEMO_API_BASE_URL=http://127.0.0.1:8000